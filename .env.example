# ==============================================================================
# LeetCode 250 DSA Agent Configuration
# ==============================================================================

# 1. Google Gemini API Key (Required for AI Problem Solving)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. LeetCode Account Credentials (Optional - for direct auto-submissions)
# How to get your LEETCODE_SESSION and csrftoken:
#  a. Open Chrome/Edge/Firefox and log in to https://leetcode.com
#  b. Press F12 -> Go to 'Application' (or 'Storage') tab -> 'Cookies' -> 'https://leetcode.com'
#  c. Copy the value of 'LEETCODE_SESSION' and 'csrftoken'
LEETCODE_SESSION=
LEETCODE_CSRFTOKEN=

# 3. Schedule Settings (24-Hour Daemon)
# Comma-separated 24-hr times of the day to trigger problem solving
# Default: 3 runs per day = 9:00 AM, 3:00 PM, 9:00 PM (1 problem each = 3 problems/day)
SCHEDULE_TIMES=09:00,15:00,21:00

# Number of questions to solve at each scheduled trigger
QUESTIONS_PER_RUN=1

# Random jitter in minutes (adds 0 to N minutes delay so submissions look natural)
RANDOM_JITTER_MINUTES=15

# (Optional) Alternative LLM: OpenAI or local OpenAI-compatible endpoint
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
